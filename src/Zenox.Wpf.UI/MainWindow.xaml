<UserControl x:Class="Zenox.Wpf.UI.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:tutorial="clr-namespace:Zenox.Wpf.Core.Common.Tutorial;assembly=Zenox.Wpf.Core"
xmlns:menu="clr-namespace:Zenox.Wpf.Controls.Common.Menu;assembly=Zenox.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <Grid>
        <!-- Hauptinhalt -->
        <DockPanel>
            <!-- Top Menu Bar mit TopMenuControl -->
            <Border DockPanel.Dock="Top" 
                    tutorial:TutorialHelper.TutorialKey="TopMenuArea"
                    Background="{DynamicResource FluentWindowBackground}"
                    BorderBrush="{DynamicResource FluentBorderBrush}"
                    BorderThickness="0,0,0,1">
                <menu:TopMenuControl MyTopMenu="{Binding MenuManager.TopMenu}" />
            </Border>

            <!-- Status Bar -->
            <StatusBar DockPanel.Dock="Bottom"
                       tutorial:TutorialHelper.TutorialKey="StatusArea"
					   Background="MediumPurple"
					   Foreground="White"
					   Height="40" Padding="0">
				<StatusBarItem Height="35">
					<Button Content="Alarming"
							Height="30"/>
                </StatusBarItem>
				<StatusBarItem Height="35">
                    <TextBlock Text="{Binding MainWindow.Status}" Foreground="White" />
                </StatusBarItem>
				<StatusBarItem HorizontalAlignment="Right"
							   Height="35">
					<StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bereit" Foreground="White"/>
                    <TextBlock Text="User: Admin" Foreground="White" Margin="10,0,0,0"/>
					</StackPanel>
				</StatusBarItem>
            </StatusBar>

            <!-- Hauptbereich mit Left Menu und Tab Control -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Menu -->
                <Border Grid.Column="0"
                        tutorial:TutorialHelper.TutorialKey="LeftMenuArea"
                        Background="{DynamicResource FluentWindowBackground}"
                        BorderBrush="{DynamicResource FluentBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <menu:LeftMenuControl MyPageLeftMenu="{Binding MenuManager.PageMenu}" />
                </Border>

                <!-- Tab Control -->
                <TabControl Grid.Column="1"
                            x:Name="tabViewControl"
                            tutorial:TutorialHelper.TutorialKey="TabArea"
                            Style="{DynamicResource FluentTabControlStyle}"
                            ItemsSource="{Binding TabView.TabItems}"
                            SelectedItem="{Binding TabView.SelectedTabItem}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" 
                                       Foreground="{StaticResource FluentTextBrush}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Content}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </DockPanel>

        <!-- Tutorial Overlay - muss über allem anderen liegen -->
        <Canvas x:Name="TutorialOverlay" 
                Visibility="Collapsed"
                Background="Transparent"
                Panel.ZIndex="999" />
    </Grid>
</UserControl>
