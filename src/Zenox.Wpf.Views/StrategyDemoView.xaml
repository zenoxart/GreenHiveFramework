<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Zenox.Wpf.Views.StrategyDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Zenox.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=local:StrategyDemoViewModel, IsDesignTimeCreatable=True}"
             Name="StrategyDemo">
    
    <UserControl.Resources>
        <local:StrategyDemoViewModel x:Key="StrategyDemoVM"/>
        
        <Style x:Key="OutputTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource FluentWindowBackground}"
          DataContext="{StaticResource StrategyDemoVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Strategy Provider Demo"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Demonstriert das Strategy-Pattern mit automatischer Strategieauswahl basierend auf Input-Typ und Prioritaet."
                       Foreground="#B0B0B0"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Input Section -->
        <GroupBox Grid.Row="1" 
                  Header="Eingabe" 
                  Margin="20,0,20,10"
                  Foreground="White">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="Text, URL, JSON, Datum, IP-Adresse, SQL, oder anderen Input eingeben:" 
                           Foreground="#B0B0B0"
                           Margin="0,0,0,5"/>
                
                <TextBox Grid.Row="1"
                         x:Name="InputTextBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="60"
                         MaxHeight="120"
                         Padding="8"
                         FontFamily="Consolas"
                         FontSize="13"/>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Auto-Erkennung"
                            Command="{Binding ExecuteAutoCommand}"
                            Style="{DynamicResource FluentTabButtonStyle}"
                            Padding="15,10"
                            Margin="0,0,10,0"
                            ToolTip="Waehlt automatisch die beste Strategie basierend auf dem Input"/>
                    
                    <ComboBox x:Name="StrategyComboBox"
                              ItemsSource="{Binding AvailableStrategies}"
                              SelectedItem="{Binding SelectedStrategy}"
                              DisplayMemberPath="Name"
                              Width="200"
                              Padding="8"
                              VerticalContentAlignment="Center"
                              Margin="0,0,10,0"/>
                    
                    <Button Content="Strategie ausfuehren"
                            Command="{Binding ExecuteSelectedCommand}"
                            Style="{DynamicResource FluentTabButtonStyle}"
                            Padding="15,10"
                            ToolTip="Fuehrt die ausgewaehlte Strategie aus"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Examples Section -->
        <Expander Grid.Row="2" 
                  Header="Beispiel-Eingaben" 
                  Margin="20,0,20,10"
                  Foreground="White"
                  IsExpanded="False">
            <StackPanel Margin="10,5,10,10">
                <TextBlock Foreground="#B0B0B0" FontSize="12" Margin="0,0,0,8">
                    Kopieren Sie eines der folgenden Beispiele in das Eingabefeld:
                </TextBlock>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="CornerRadius" Value="3"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="0,3,10,3"/>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#90CAF9"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Border><TextBlock Text="https://example.com/path?id=123&amp;name=test"/></Border>
                    <Border><TextBlock Text="user@example.com"/></Border>
                    <Border><TextBlock Text="25.12.2024 14:30"/></Border>
                    <Border><TextBlock Text="192.168.1.1/24"/></Border>
                    <Border><TextBlock Text="SELECT * FROM users WHERE id = 1"/></Border>
                    <Border><TextBlock Text="myVariableName"/></Border>
                    <Border><TextBlock Text="SGVsbG8gV29ybGQh (Base64)"/></Border>
                    <Border><TextBlock Text="4532015112830366 (Kreditkarte)"/></Border>
                </WrapPanel>
            </StackPanel>
        </Expander>

        <!-- Output Section -->
        <GroupBox Grid.Row="3" 
                  Header="Ausgabe" 
                  Margin="20,0,20,10"
                  Foreground="White">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                           Text="{Binding UsedStrategyInfo}"
                           Foreground="#4CAF50"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                
                <Border Grid.Row="1"
                        Background="#1E1E1E"
                        BorderBrush="#3E3E3E"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="12">
                        <TextBlock Text="{Binding OutputText}"
                                   Style="{StaticResource OutputTextStyle}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Registered Strategies List -->
        <GroupBox Grid.Row="4" 
                  Header="Registrierte Strategien (nach Prioritaet sortiert)" 
                  Margin="20,0,20,20"
                  Foreground="White">
            <DataGrid ItemsSource="{Binding AvailableStrategies}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      RowBackground="#2D2D2D"
                      AlternatingRowBackground="#252525"
                      BorderThickness="0"
                      Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64B5F6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Prio" Binding="{Binding Priority}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFA726"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
