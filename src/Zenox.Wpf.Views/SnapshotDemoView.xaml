<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Zenox.Wpf.Views.SnapshotDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Zenox.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=local:SnapshotDemoViewModel, IsDesignTimeCreatable=True}"
             Name="SnapshotDemo">
    
    <UserControl.Resources>
        <local:SnapshotDemoViewModel x:Key="SnapshotDemoVM"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style x:Key="JsonTextStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        
        <Style x:Key="ExampleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource FluentWindowBackground}"
          DataContext="{StaticResource SnapshotDemoVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Snapshot Manager Demo"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Demonstriert das Snapshot-System fuer Zustandssicherung, Undo/Redo und Recovery."
                       Foreground="#B0B0B0"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Create Snapshot Section -->
        <GroupBox Grid.Row="1" 
                  Header="Neuen Snapshot erstellen" 
                  Margin="20,0,20,10"
                  Foreground="White">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                
                <!-- Snapshot Name -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Snapshot-Name:" Foreground="#B0B0B0" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SnapshotName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8"
                             FontSize="13"/>
                </StackPanel>
                
                <!-- Snapshot Type -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Typ:" Foreground="#B0B0B0" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding SnapshotTypes}"
                              SelectedItem="{Binding SelectedType}"
                              Padding="8"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
                
                <!-- Example Buttons -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Beispiele laden:" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Einfach" Style="{StaticResource ExampleButtonStyle}"
                            Command="{Binding LoadExampleStateCommand}" CommandParameter="simple"/>
                    <Button Content="Benutzer" Style="{StaticResource ExampleButtonStyle}"
                            Command="{Binding LoadExampleStateCommand}" CommandParameter="user"/>
                    <Button Content="Einstellungen" Style="{StaticResource ExampleButtonStyle}"
                            Command="{Binding LoadExampleStateCommand}" CommandParameter="settings"/>
                    <Button Content="Fenster-Layout" Style="{StaticResource ExampleButtonStyle}"
                            Command="{Binding LoadExampleStateCommand}" CommandParameter="window"/>
                    <Button Content="Komplex" Style="{StaticResource ExampleButtonStyle}"
                            Command="{Binding LoadExampleStateCommand}" CommandParameter="complex"/>
                </StackPanel>
                
                <!-- State Data Label -->
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" 
                           Text="Zustandsdaten (JSON):" 
                           Foreground="#B0B0B0" 
                           Margin="0,0,0,5"/>
                
                <!-- State Data Input -->
                <TextBox Grid.Row="3" Grid.ColumnSpan="2"
                         Text="{Binding StateData, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource JsonTextStyle}"/>
                
                <!-- Create Button -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" 
                            Margin="0,12,0,0">
                    <Button Content="Snapshot erstellen"
                            Command="{Binding CreateSnapshotCommand}"
                            Style="{DynamicResource FluentTabButtonStyle}"
                            Padding="20,10"
                            Margin="0,0,10,0"/>
                    <Button Content="Aktualisieren"
                            Command="{Binding RefreshSnapshotsCommand}"
                            Style="{DynamicResource FluentTabButtonStyle}"
                            Padding="15,10"
                            Margin="0,0,10,0"/>
                    <Button Content="Alle loeschen"
                            Command="{Binding ClearAllSnapshotsCommand}"
                            Style="{DynamicResource FluentTabButtonStyle}"
                            Padding="15,10"
                            Foreground="#FF6B6B"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Main Content: Snapshots List and Details -->
        <Grid Grid.Row="2" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Snapshots List -->
            <GroupBox Grid.Column="0" 
                      Header="Gespeicherte Snapshots" 
                      Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Snapshots}"
                              SelectedItem="{Binding SelectedSnapshot}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              RowBackground="#2D2D2D"
                              AlternatingRowBackground="#252525"
                              BorderThickness="0"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64B5F6"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5,8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFA726"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5,8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Timestamp, StringFormat='{}{0:dd.MM.yy HH:mm}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B0B0B0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5,8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Groesse" Binding="{Binding SizeBytes, StringFormat='{}{0} B'}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#81C784"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Wiederherstellen"
                                Command="{Binding RestoreSnapshotCommand}"
                                Style="{DynamicResource FluentTabButtonStyle}"
                                Padding="15,8"
                                Margin="0,0,10,0"/>
                        <Button Content="Loeschen"
                                Command="{Binding DeleteSnapshotCommand}"
                                Style="{DynamicResource FluentTabButtonStyle}"
                                Padding="15,8"
                                Foreground="#FF6B6B"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
            
            <!-- Snapshot Details -->
            <GroupBox Grid.Column="2" 
                      Header="Snapshot-Details" 
                      Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Selected Snapshot Info -->
                    <Border Grid.Row="0" 
                            Background="#252525" 
                            CornerRadius="4" 
                            Padding="10" 
                            Margin="0,0,0,10"
                            Visibility="{Binding SelectedSnapshot, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="ID: " Foreground="#808080"/>
                                <TextBlock Text="{Binding SelectedSnapshot.Id}" Foreground="#B0B0B0" FontFamily="Consolas" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Version: " Foreground="#808080"/>
                                <TextBlock Text="{Binding SelectedSnapshot.AppVersion}" Foreground="#B0B0B0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Erstellt: " Foreground="#808080"/>
                                <TextBlock Text="{Binding SelectedSnapshot.Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Restored Data -->
                    <Border Grid.Row="1"
                            Background="#1E1E1E"
                            BorderBrush="#3E3E3E"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Padding="12">
                            <TextBlock Text="{Binding RestoredData}"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="12"
                                       Foreground="#E0E0E0"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="#252525" 
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#4CAF50"
                           VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalSizeInfo}"
                           Foreground="#808080"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
