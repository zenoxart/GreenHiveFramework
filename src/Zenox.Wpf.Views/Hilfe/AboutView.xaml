<UserControl x:Class="Zenox.Wpf.Views.Hilfe.AboutView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:Zenox.Wpf.Views.Hilfe"
			 mc:Ignorable="d"
			 d:DesignHeight="700"
			 d:DesignWidth="900"
			 d:DataContext="{d:DesignInstance Type=local:AboutViewModel, IsDesignTimeCreatable=True}">
	
	<UserControl.Resources>
		
		<!-- Info Card Style -->
		<Style x:Key="InfoCardStyle" TargetType="Border">
			<Setter Property="Background" Value="#2A2A2A"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Margin" Value="0,0,0,15"/>
		</Style>
		
		<!-- Section Header Style -->
		<Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Margin" Value="0,0,0,15"/>
		</Style>
		
		<!-- Action Button Style -->
		<Style x:Key="ActionButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#3A3A3A"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="15,10"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Border" 
								Background="{TemplateBinding Background}" 
								CornerRadius="6"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Border" Property="Background" Value="#4A4A4A"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Border" Property="Background" Value="#5A5A5A"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		
		<!-- Info Row Style -->
		<Style x:Key="InfoRowStyle" TargetType="Grid">
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>
		
		<!-- Label Style -->
		<Style x:Key="LabelStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#808080"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		
		<!-- Value Style -->
		<Style x:Key="ValueStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		
		<!-- Feature Item Style -->
		<Style x:Key="FeatureItemStyle" TargetType="Border">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="15"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>
	</UserControl.Resources>
	
	<Grid Background="{DynamicResource FluentWindowBackground}">
		
		<!-- Main ScrollViewer -->
		<ScrollViewer VerticalScrollBarVisibility="Auto" 
					  HorizontalScrollBarVisibility="Disabled"
					  Padding="30">
			<StackPanel MaxWidth="800">
				
				<!-- Header Section with Logo -->
				<Border Style="{StaticResource InfoCardStyle}" 
						Background="#1E88E5"
						Margin="0,0,0,20">
					<StackPanel HorizontalAlignment="Center">
						<!-- App Icon/Logo Placeholder -->
						<Border Width="80" Height="80" 
								Background="#1565C0" 
								CornerRadius="40"
								Margin="0,0,0,15">
							<TextBlock Text="Z" 
									   FontSize="48" 
									   FontWeight="Bold"
									   Foreground="White"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Border>
						
						<TextBlock Text="{Binding ApplicationName}"
								   FontSize="32"
								   FontWeight="Bold"
								   Foreground="White"
								   HorizontalAlignment="Center"/>
						
						<TextBlock Text="{Binding Description}"
								   FontSize="14"
								   Foreground="#E0E0E0"
								   HorizontalAlignment="Center"
								   TextWrapping="Wrap"
								   TextAlignment="Center"
								   Margin="0,8,0,0"/>
						
						<TextBlock FontSize="16"
								   Foreground="#E0E0E0"
								   HorizontalAlignment="Center"
								   Margin="0,12,0,0">
							<Run Text="Version"/>
							<Run Text="{Binding Version}" FontWeight="Bold"/>
						</TextBlock>
					</StackPanel>
				</Border>
				
				<!-- Quick Actions -->
				<StackPanel Orientation="Horizontal" 
							HorizontalAlignment="Center"
							Margin="0,0,0,25">
					<Button Content="🌐 Website besuchen"
							Command="{Binding OpenWebsiteCommand}"
							Style="{StaticResource ActionButtonStyle}"/>
					<Button Content="📚 Dokumentation"
							Command="{Binding OpenDocumentationCommand}"
							Style="{StaticResource ActionButtonStyle}"/>
					<Button Content="🔄 Nach Updates suchen"
							Command="{Binding CheckForUpdatesCommand}"
							Style="{StaticResource ActionButtonStyle}"
							Margin="0"/>
				</StackPanel>
				
				<!-- Application Information Section -->
				<Border Style="{StaticResource InfoCardStyle}">
					<StackPanel>
						<TextBlock Text="Anwendungsinformationen" 
								   Style="{StaticResource SectionHeaderStyle}"/>
						
						<Grid Style="{StaticResource InfoRowStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Produktname:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding ApplicationName}" Style="{StaticResource ValueStyle}"/>
						</Grid>
						
						<Grid Style="{StaticResource InfoRowStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Version:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource ValueStyle}"/>
						</Grid>
						
						<Grid Style="{StaticResource InfoRowStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Entwickler:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding Author}" Style="{StaticResource ValueStyle}"/>
						</Grid>
						
						<Grid Style="{StaticResource InfoRowStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Build-Datum:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding BuildDate}" Style="{StaticResource ValueStyle}"/>
						</Grid>
						
						<Grid Style="{StaticResource InfoRowStyle}" Margin="0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Framework:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding FrameworkVersion}" Style="{StaticResource ValueStyle}"/>
						</Grid>
					</StackPanel>
				</Border>
				
				<!-- Features Section -->
				<Border Style="{StaticResource InfoCardStyle}">
					<StackPanel>
						<TextBlock Text="Hauptfunktionen" 
								   Style="{StaticResource SectionHeaderStyle}"/>
						
						<Border Style="{StaticResource FeatureItemStyle}">
							<StackPanel>
								<TextBlock Text="🎨 Moderne MVVM-Architektur"
										   Foreground="White"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Margin="0,0,0,5"/>
								<TextBlock Text="Vollständige Implementierung des MVVM-Patterns mit ViewModelLocator und DataBinding"
										   Foreground="#B0B0B0"
										   FontSize="11"
										   TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
						
						<Border Style="{StaticResource FeatureItemStyle}">
							<StackPanel>
								<TextBlock Text="⚡ Command-System"
										   Foreground="White"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Margin="0,0,0,5"/>
								<TextBlock Text="Synchrone und asynchrone Commands mit Command-Pooling für optimale Performance"
										   Foreground="#B0B0B0"
										   FontSize="11"
										   TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
						
						<Border Style="{StaticResource FeatureItemStyle}">
							<StackPanel>
								<TextBlock Text="🔔 Benachrichtigungssystem"
										   Foreground="White"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Margin="0,0,0,5"/>
								<TextBlock Text="Toast-Benachrichtigungen und In-App-Notifications mit Notification-Center"
										   Foreground="#B0B0B0"
										   FontSize="11"
										   TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
						
						<Border Style="{StaticResource FeatureItemStyle}">
							<StackPanel>
								<TextBlock Text="🔐 Sicherheit &amp; Berechtigungen"
										   Foreground="White"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Margin="0,0,0,5"/>
								<TextBlock Text="SecureStorage für sensible Daten und attributbasierte Autorisierung"
										   Foreground="#B0B0B0"
										   FontSize="11"
										   TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
						
						<Border Style="{StaticResource FeatureItemStyle}">
							<StackPanel>
								<TextBlock Text="📊 Performance-Monitoring"
										   Foreground="White"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Margin="0,0,0,5"/>
								<TextBlock Text="Performance-Overlay, Execution-Logging und Telemetrie für optimale Überwachung"
										   Foreground="#B0B0B0"
										   FontSize="11"
										   TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
						
						<Border Style="{StaticResource FeatureItemStyle}" Margin="0">
							<StackPanel>
								<TextBlock Text="🎓 Tutorial-System"
										   Foreground="White"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Margin="0,0,0,5"/>
								<TextBlock Text="Interaktive XML-basierte Tutorials mit Step-by-Step-Guides"
										   Foreground="#B0B0B0"
										   FontSize="11"
										   TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>
				
				<!-- System Information Section -->
				<Border Style="{StaticResource InfoCardStyle}">
					<StackPanel>
						<TextBlock Text="Systeminformationen" 
								   Style="{StaticResource SectionHeaderStyle}"/>
						
						<Grid Style="{StaticResource InfoRowStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Betriebssystem:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" Style="{StaticResource ValueStyle}"/>
						</Grid>
						
						<Grid Style="{StaticResource InfoRowStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="64-Bit System:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding Is64BitSystem}" Style="{StaticResource ValueStyle}"/>
						</Grid>
						
						<Grid Style="{StaticResource InfoRowStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Prozessoren:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding ProcessorCount}" Style="{StaticResource ValueStyle}"/>
						</Grid>
						
						<Grid Style="{StaticResource InfoRowStyle}" Margin="0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Computername:" Style="{StaticResource LabelStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding MachineName}" Style="{StaticResource ValueStyle}"/>
						</Grid>
					</StackPanel>
				</Border>
				
				<!-- Copyright & Legal Section -->
				<Border Style="{StaticResource InfoCardStyle}" Margin="0">
					<StackPanel>
						<TextBlock Text="Rechtliches" 
								   Style="{StaticResource SectionHeaderStyle}"/>
						
						<TextBlock Text="{Binding Copyright}"
								   Foreground="#B0B0B0"
								   FontSize="12"
								   TextWrapping="Wrap"
								   Margin="0,0,0,10"/>
						
						<StackPanel Orientation="Horizontal">
							<Button Content="📄 Lizenz anzeigen"
									Command="{Binding OpenLicenseCommand}"
									Style="{StaticResource ActionButtonStyle}"
									Padding="12,8"
									FontSize="11"/>
						</StackPanel>
					</StackPanel>
				</Border>
				
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
