<UserControl x:Class="Zenox.Wpf.Views.ProfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Zenox.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:ProfilViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <local:ProfilViewModel x:Key="ProfilVM"/>

        <Style x:Key="ProfileSectionStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="ProfileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="13"
                                Padding="3">
                            <Ellipse x:Name="Thumb" 
                                     Width="20" 
                                     Height="20" 
                                     Fill="White"
                                     HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ProfileDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ProfileTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ProfilePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FluentWindowBackground}"
          DataContext="{StaticResource ProfilVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="{DynamicResource Profile_Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="{DynamicResource Profile_Description}"
                       Foreground="#B0B0B0"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>


        <!-- Profile Content with TreeView -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView Navigation -->
            <Border Grid.Column="0" 
                    Background="#1E1E1E" 
                    BorderBrush="#3A3A3A" 
                    BorderThickness="1"
                    CornerRadius="4">
                <TreeView x:Name="ProfileTree"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="10"
                          SelectedItemChanged="ProfileTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="ItemBorder"
                                                    Grid.Row="0"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander"
                                                                  Grid.Column="0"
                                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  ClickMode="Press"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  Padding="4"
                                                                  Margin="0,0,4,0"
                                                                  Visibility="Collapsed">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <TextBlock x:Name="ExpanderText" Text="►" Foreground="#808080" FontSize="10"/>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="ExpanderText" Property="Text" Value="▼"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter Grid.Row="1" 
                                                            x:Name="ItemsHost" 
                                                            Margin="20,0,0,0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="True">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#4A4A6A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                    
                    <TreeViewItem Header="{DynamicResource Profile_Overview}" Tag="ProfileOverview" IsExpanded="False"/>
                    <TreeViewItem Header="{DynamicResource Profile_PersonalInfo}" Tag="PersonalInfo" IsExpanded="False"/>
                    <TreeViewItem Header="{DynamicResource Profile_Notifications}" Tag="Notifications" IsExpanded="False"/>
                    <TreeViewItem Header="{DynamicResource Profile_Privacy}" Tag="Privacy" IsExpanded="False"/>
                    <TreeViewItem Header="{DynamicResource Profile_Security}" Tag="Security" IsExpanded="False"/>
                </TreeView>
            </Border>


            <!-- Content Panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel">
                    
                    <!-- Profile Overview Panel -->
                    <StackPanel x:Name="ProfileOverviewPanel" Visibility="Visible">
                        <TextBlock Text="{DynamicResource Profile_Overview}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>

                        
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <StackPanel Grid.Column="0" Margin="0,0,25,0">
                                <Border Width="100" 
                                        Height="100" 
                                        CornerRadius="50"
                                        Background="#4A4A6A">
                                    <TextBlock Text="{Binding Initials}"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Button Content="{DynamicResource Profile_Change}"
                                        Command="{Binding ChangeAvatarCommand}"
                                        Style="{DynamicResource FluentTabButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Padding="15,6"
                                        Margin="0,10,0,0"
                                        FontSize="11"/>
                            </StackPanel>

                            <!-- Basic Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="{Binding Email}"
                                           FontSize="13"
                                           Foreground="#808080"
                                           Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="#3A3A3A" 
                                            CornerRadius="4" 
                                            Padding="10,5"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Role}" 
                                                   FontSize="11" 
                                                   Foreground="#B0B0B0"/>
                                    </Border>
                                    <Border Background="#3A3A3A" 
                                            CornerRadius="4" 
                                            Padding="10,5">
                                        <TextBlock Text="{Binding Department}" 
                                                   FontSize="11" 
                                                   Foreground="#B0B0B0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                    <TextBlock FontSize="11" Foreground="#606060">
                                        <Run Text="{DynamicResource Profile_MemberSince}"/>
                                        <Run Text=": "/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MemberSince, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                               FontSize="11" 
                                               Foreground="#808080"/>
                                    <TextBlock Text="  |  " 
                                               FontSize="11" 
                                               Foreground="#606060"/>
                                    <TextBlock FontSize="11" Foreground="#606060">
                                        <Run Text="{DynamicResource Profile_LastLogin}"/>
                                        <Run Text=": "/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LastLogin, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                               FontSize="11" 
                                               Foreground="#808080"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Personal Info Panel -->
                    <StackPanel x:Name="PersonalInfoPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Profile_PersonalInfo}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>

                        
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Anzeigename -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,5,0,15">
                                <TextBlock Text="Anzeigename" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Benutzername -->
                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,5,0,15">
                                <TextBlock Text="Benutzername" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileTextBoxStyle}"
                                         IsReadOnly="True"
                                         Opacity="0.7"/>
                            </StackPanel>

                            <!-- E-Mail -->
                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,15">
                                <TextBlock Text="E-Mail" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Telefon -->
                            <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,15">
                                <TextBlock Text="Telefon" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Abteilung -->
                            <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,15">
                                <TextBlock Text="Abteilung" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Standort -->
                            <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,15">
                                <TextBlock Text="Standort" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Notifications Panel -->
                    <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Profile_Notifications}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>
                        
                        <TextBlock Text="{DynamicResource Profile_NotificationsDesc}"
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <!-- E-Mail Notifications -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Profile_EmailNotifications}" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Profile_EmailNotificationsDesc}" 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding EmailNotifications}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Push Notifications -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Profile_PushNotifications}" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Profile_PushNotificationsDesc}" 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding PushNotifications}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Sound Notifications -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Profile_SoundNotifications}" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Profile_SoundNotificationsDesc}" 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SoundNotifications}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Privacy Panel -->
                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Profile_Privacy}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>
                        
                        <TextBlock Text="{DynamicResource Profile_PrivacyDesc}"
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <!-- Show Online Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Profile_ShowOnlineStatus}" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Profile_ShowOnlineStatusDesc}" 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding ShowOnlineStatus}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Show Last Seen -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Profile_ShowLastSeen}" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Profile_ShowLastSeenDesc}" 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding ShowLastSeen}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Allow Profile Viewing -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Profile_ProfileVisible}" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Profile_ProfileVisibleDesc}" 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding AllowProfileViewing}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Security Panel -->
                    <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Profile_Security}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>
                        
                        <TextBlock Text="{DynamicResource Profile_ChangePasswordDesc}"
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Aktuelles Passwort -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Profile_CurrentPassword}" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <PasswordBox Style="{StaticResource ProfilePasswordBoxStyle}"/>
                            </StackPanel>

                            <!-- Neues Passwort -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Profile_NewPassword}" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <PasswordBox Style="{StaticResource ProfilePasswordBoxStyle}"/>
                            </StackPanel>

                            <!-- Passwort bestaetigen -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Profile_ConfirmPassword}" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <PasswordBox Style="{StaticResource ProfilePasswordBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="{DynamicResource Profile_ChangePassword}"
                                Command="{Binding ChangePasswordCommand}"
                                Style="{DynamicResource FluentTabButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="20,8"
                                Margin="0,15,0,0"/>
                    </StackPanel>


                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#252525" 
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#4CAF50"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="{DynamicResource Profile_ResetProfile}"
                        Command="{Binding ResetProfileCommand}"
                        Style="{DynamicResource FluentTabButtonStyle}"
                        Padding="20,8"
                        Margin="0,0,10,0"
                        Foreground="#808080"/>

                <Button Grid.Column="2"
                        Content="{DynamicResource Profile_SaveProfile}"
                        Command="{Binding SaveProfileCommand}"
                        Style="{DynamicResource FluentTabButtonStyle}"
                        Padding="20,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>