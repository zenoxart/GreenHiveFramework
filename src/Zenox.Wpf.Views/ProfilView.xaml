<UserControl x:Class="Zenox.Wpf.Views.ProfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Zenox.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:ProfilViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <local:ProfilViewModel x:Key="ProfilVM"/>

        <Style x:Key="ProfileSectionStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="ProfileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="13"
                                Padding="3">
                            <Ellipse x:Name="Thumb" 
                                     Width="20" 
                                     Height="20" 
                                     Fill="White"
                                     HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ProfileDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ProfileTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ProfilePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FluentWindowBackground}"
          DataContext="{StaticResource ProfilVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Profil"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Verwalten Sie Ihre persoenlichen Informationen und Einstellungen."
                       Foreground="#B0B0B0"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Profile Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="20,10,20,0">
            <StackPanel>

                <!-- Profile Card Section -->
                <GroupBox Header="Profiluebersicht" Style="{StaticResource ProfileSectionStyle}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <StackPanel Grid.Column="0" Margin="0,0,25,0">
                            <Border Width="100" 
                                    Height="100" 
                                    CornerRadius="50"
                                    Background="#4A4A6A">
                                <TextBlock Text="{Binding Initials}"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="Aendern"
                                    Command="{Binding ChangeAvatarCommand}"
                                    Style="{DynamicResource FluentTabButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Padding="15,6"
                                    Margin="0,10,0,0"
                                    FontSize="11"/>
                        </StackPanel>

                        <!-- Basic Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding Email}"
                                       FontSize="13"
                                       Foreground="#808080"
                                       Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="#3A3A3A" 
                                        CornerRadius="4" 
                                        Padding="10,5"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Role}" 
                                               FontSize="11" 
                                               Foreground="#B0B0B0"/>
                                </Border>
                                <Border Background="#3A3A3A" 
                                        CornerRadius="4" 
                                        Padding="10,5">
                                    <TextBlock Text="{Binding Department}" 
                                               FontSize="11" 
                                               Foreground="#B0B0B0"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <TextBlock Text="Mitglied seit: " 
                                           FontSize="11" 
                                           Foreground="#606060"/>
                                <TextBlock Text="{Binding MemberSince, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                           FontSize="11" 
                                           Foreground="#808080"/>
                                <TextBlock Text="  |  Letzter Login: " 
                                           FontSize="11" 
                                           Foreground="#606060"/>
                                <TextBlock Text="{Binding LastLogin, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                           FontSize="11" 
                                           Foreground="#808080"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Personal Information Section -->
                <GroupBox Header="Persoenliche Informationen" Style="{StaticResource ProfileSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Anzeigename -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,5,0,15">
                            <TextBlock Text="Anzeigename" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Benutzername -->
                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,5,0,15">
                            <TextBlock Text="Benutzername" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}"
                                     IsReadOnly="True"
                                     Opacity="0.7"/>
                        </StackPanel>

                        <!-- E-Mail -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="E-Mail" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Telefon -->
                        <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="Telefon" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Abteilung -->
                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,15">
                            <TextBlock Text="Abteilung" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Standort -->
                        <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,15">
                            <TextBlock Text="Standort" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Notification Settings Section -->
                <GroupBox Header="Benachrichtigungen" Style="{StaticResource ProfileSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Legen Sie fest, wie Sie benachrichtigt werden moechten."
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <!-- E-Mail Notifications -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="E-Mail-Benachrichtigungen" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="Erhalten Sie wichtige Updates per E-Mail." 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding EmailNotifications}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Push Notifications -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Push-Benachrichtigungen" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="Desktop-Benachrichtigungen fuer wichtige Ereignisse." 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding PushNotifications}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Sound Notifications -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ton-Benachrichtigungen" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="Akustische Signale bei Benachrichtigungen." 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SoundNotifications}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Privacy Settings Section -->
                <GroupBox Header="Datenschutz" Style="{StaticResource ProfileSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Verwalten Sie Ihre Privatsphaere-Einstellungen."
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <!-- Show Online Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Online-Status anzeigen" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="Andere Benutzer koennen sehen, ob Sie online sind." 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding ShowOnlineStatus}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Show Last Seen -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Zuletzt gesehen anzeigen" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="Zeigt an, wann Sie zuletzt aktiv waren." 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding ShowLastSeen}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Allow Profile Viewing -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Profil sichtbar" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="Andere Benutzer koennen Ihr Profil einsehen." 
                                           Style="{StaticResource ProfileDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding AllowProfileViewing}" 
                                          Style="{StaticResource ProfileToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Security Section -->
                <GroupBox Header="Sicherheit" Style="{StaticResource ProfileSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Aendern Sie Ihr Passwort fuer mehr Sicherheit."
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Aktuelles Passwort -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Aktuelles Passwort" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <PasswordBox Style="{StaticResource ProfilePasswordBoxStyle}"/>
                            </StackPanel>

                            <!-- Neues Passwort -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Neues Passwort" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <PasswordBox Style="{StaticResource ProfilePasswordBoxStyle}"/>
                            </StackPanel>

                            <!-- Passwort bestaetigen -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Passwort bestaetigen" Style="{StaticResource ProfileLabelStyle}" Margin="0,0,0,5"/>
                                <PasswordBox Style="{StaticResource ProfilePasswordBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Passwort aendern"
                                Command="{Binding ChangePasswordCommand}"
                                Style="{DynamicResource FluentTabButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="20,8"
                                Margin="0,15,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#252525" 
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#4CAF50"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Zuruecksetzen"
                        Command="{Binding ResetProfileCommand}"
                        Style="{DynamicResource FluentTabButtonStyle}"
                        Padding="20,8"
                        Margin="0,0,10,0"
                        Foreground="#808080"/>

                <Button Grid.Column="2"
                        Content="Profil speichern"
                        Command="{Binding SaveProfileCommand}"
                        Style="{DynamicResource FluentTabButtonStyle}"
                        Padding="20,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>