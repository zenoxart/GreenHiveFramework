<UserControl x:Class="Zenox.Wpf.Views.EinstellungenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Zenox.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:EinstellungenViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <local:EinstellungenViewModel x:Key="EinstellungenVM"/>

        <Style x:Key="SettingsSectionStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="13"
                                Padding="3">
                            <Ellipse x:Name="Thumb" 
                                     Width="20" 
                                     Height="20" 
                                     Fill="White"
                                     HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SnapshotListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#4A4A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FluentWindowBackground}"
          DataContext="{StaticResource EinstellungenVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="{DynamicResource Settings_Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="{DynamicResource Settings_Description}"
                       Foreground="#B0B0B0"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>


        <!-- Settings Content with TreeView -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView Navigation -->
            <Border Grid.Column="0" 
                    Background="#1E1E1E" 
                    BorderBrush="#3A3A3A" 
                    BorderThickness="1"
                    CornerRadius="4">
                <TreeView x:Name="SettingsTree"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="10"
                          SelectedItemChanged="SettingsTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="ItemBorder"
                                                    Grid.Row="0"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander"
                                                                  Grid.Column="0"
                                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  ClickMode="Press"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  Padding="4"
                                                                  Margin="0,0,4,0"
                                                                  Visibility="Collapsed">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <TextBlock x:Name="ExpanderText" Text="►" Foreground="#808080" FontSize="10"/>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="ExpanderText" Property="Text" Value="▼"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter Grid.Row="1" 
                                                            x:Name="ItemsHost" 
                                                            Margin="20,0,0,0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="True">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#4A4A6A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                    
                    
                    
                    
                    
                    <TreeViewItem Header="{DynamicResource Settings_SnapshotSettings}" Tag="SnapshotSettings" IsExpanded="True">
                        <TreeViewItem Header="{DynamicResource Settings_Automation}" Tag="AutomationSettings"/>
                        <TreeViewItem Header="{DynamicResource Settings_Categories}" Tag="CategorySettings"/>
                        <TreeViewItem Header="{DynamicResource Settings_Management}" Tag="ManagementSettings"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{DynamicResource Settings_LoadSnapshot}" Tag="LoadSnapshot" IsExpanded="False"/>
                    <TreeViewItem Header="{DynamicResource Settings_Shortcuts}" Tag="ShortcutSettings" IsExpanded="False"/>
                    <TreeViewItem Header="{DynamicResource Settings_WindowManagement}" Tag="WindowManagement" IsExpanded="False"/>
                    <TreeViewItem Header="{DynamicResource Settings_Language}" Tag="LanguageSettings" IsExpanded="False"/>
                </TreeView>
            </Border>


            <!-- Content Panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel">
                    
                    <!-- Automation Settings Content -->
                    <StackPanel x:Name="AutomationSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Settings_AutomationTitle}" FontSize="20" FontWeight="SemiBold" Foreground="White"
                                Margin="0,0,0,20" />
                        <!-- Auto-Snapshots Toggle -->
                        <Grid Margin="0,5,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Settings_AutoSnapshots}" Style="{StaticResource SettingsLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_AutoSnapshotsDesc}" 
                                           Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding AutoSnapshotsEnabled}" 
                                          Style="{StaticResource SettingsToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Interval Setting -->
                        <Grid Margin="0,0,0,15" IsEnabled="{Binding AutoSnapshotsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Settings_Interval}" Style="{StaticResource SettingsLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_IntervalDesc}" 
                                           Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding AutoSnapshotIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Padding="8,6"
                                     FontSize="13"/>
                        </Grid>

                        <!-- Max Snapshots -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Settings_MaxCount}" Style="{StaticResource SettingsLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_MaxCountDesc}" 
                                           Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding MaxSnapshotCount, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Padding="8,6"
                                     FontSize="13"/>
                        </Grid>

                        <!-- Snapshot on Startup -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Settings_SnapshotOnStartup}" Style="{StaticResource SettingsLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_SnapshotOnStartupDesc}" 
                                           Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SnapshotOnStartup}" 
                                          Style="{StaticResource SettingsToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Snapshot on Shutdown -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Settings_SnapshotOnShutdown}" Style="{StaticResource SettingsLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_SnapshotOnShutdownDesc}" 
                                           Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SnapshotOnShutdown}" 
                                          Style="{StaticResource SettingsToggleStyle}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>


                    <!-- Category Settings Content -->
                    <StackPanel x:Name="CategorySettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Settings_CategoriesTitle}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>
                        
                        <TextBlock Text="{DynamicResource Settings_CategoriesDesc}"
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <!-- Window Layout -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_WindowLayout}" Style="{StaticResource SettingsLabelStyle}"/>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SnapshotWindowLayout}" 
                                          Style="{StaticResource SettingsToggleStyle}"/>
                        </Grid>

                        <!-- User Settings -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_UserSettings}" Style="{StaticResource SettingsLabelStyle}"/>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SnapshotUserSettings}" 
                                          Style="{StaticResource SettingsToggleStyle}"/>
                        </Grid>

                        <!-- App Configuration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_AppConfiguration}" Style="{StaticResource SettingsLabelStyle}"/>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SnapshotAppConfiguration}" 
                                          Style="{StaticResource SettingsToggleStyle}"/>
                        </Grid>

                        <!-- Session Data -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_SessionData}" Style="{StaticResource SettingsLabelStyle}"/>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SnapshotSessionData}" 
                                          Style="{StaticResource SettingsToggleStyle}"/>
                        </Grid>

                        <!-- Custom Data -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_CustomData}" Style="{StaticResource SettingsLabelStyle}"/>
                            <ToggleButton Grid.Column="1" 
                                          IsChecked="{Binding SnapshotCustomData}" 
                                          Style="{StaticResource SettingsToggleStyle}"/>
                        </Grid>
                    </StackPanel>


                    <!-- Management Settings Content -->
                    <StackPanel x:Name="ManagementSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Settings_ManagementTitle}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>
                        
                        <!-- Info -->
                        <Border Background="#252525" CornerRadius="4" Padding="15" Margin="0,5,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings_SavedSnapshots}" Foreground="#808080" FontSize="11"/>
                                    <TextBlock Text="{Binding SnapshotCount}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Settings_TotalSize}" Foreground="#808080" FontSize="11"/>
                                    <TextBlock Text="{Binding TotalSnapshotSize}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="{DynamicResource Settings_CreateSnapshot}"
                                    Command="{Binding CreateManualSnapshotCommand}"
                                    Style="{DynamicResource FluentTabButtonStyle}"
                                    Padding="15,8"
                                    Margin="0,0,10,0"/>
                            <Button Content="{DynamicResource Settings_DeleteAllSnapshots}"
                                    Command="{Binding ClearAllSnapshotsCommand}"
                                    Style="{DynamicResource FluentTabButtonStyle}"
                                    Padding="15,8"
                                    Foreground="#FF6B6B"/>
                        </StackPanel>
                    </StackPanel>


                    <!-- Load Snapshot Content -->
                    <StackPanel x:Name="LoadSnapshotPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Settings_LoadSnapshotTitle}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header mit Refresh -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Settings_AvailableSnapshots}" 
                                           Style="{StaticResource SettingsLabelStyle}"
                                           VerticalAlignment="Center"/>
                                <Button Content="⟳" 
                                        Command="{Binding RefreshSnapshotsCommand}"
                                        Background="Transparent"
                                        Foreground="#808080"
                                        BorderThickness="0"
                                        FontSize="16"
                                        Padding="8,4"
                                        Margin="10,0,0,0"
                                        Cursor="Hand"
                                        ToolTip="{DynamicResource Settings_RefreshList}"/>
                            </StackPanel>

                            <!-- Snapshot List -->
                            <ListBox Grid.Column="0" Grid.Row="1"
                                     ItemsSource="{Binding AvailableSnapshots}"
                                     SelectedItem="{Binding SelectedSnapshot}"
                                     Background="#1E1E1E"
                                     BorderBrush="#3A3A3A"
                                     BorderThickness="1"
                                     ItemContainerStyle="{StaticResource SnapshotListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Type}" 
                                                               FontSize="11" 
                                                               Foreground="MediumPurple"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yy HH:mm}'}" 
                                                               FontSize="11" 
                                                               Foreground="#808080"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Category}" 
                                                       FontSize="10" 
                                                       Foreground="#606060"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Snapshot Details -->
                            <TextBlock Grid.Column="2" Grid.Row="0" 
                                       Text="{DynamicResource Settings_Details}" 
                                       Style="{StaticResource SettingsLabelStyle}"
                                       Margin="0,0,0,10"/>
                            
                            <Border Grid.Column="2" Grid.Row="1"
                                    Background="#1E1E1E"
                                    BorderBrush="#3A3A3A"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12">
                                <TextBlock Text="{Binding SelectedSnapshotDetails}"
                                           Foreground="#B0B0B0"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Actions -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" 
                                        Orientation="Horizontal" 
                                        Margin="0,15,0,0">
                                <Button Content="{DynamicResource Settings_LoadSnapshot}"
                                        Command="{Binding LoadSnapshotCommand}"
                                        Style="{DynamicResource FluentTabButtonStyle}"
                                        Padding="15,8"
                                        Margin="0,0,10,0"/>
                                <Button Content="{DynamicResource Settings_DeleteSnapshot}"
                                        Command="{Binding DeleteSnapshotCommand}"
                                        Style="{DynamicResource FluentTabButtonStyle}"
                                        Padding="15,8"
                                        Foreground="#FF6B6B"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>


                    <!-- Shortcut Settings Content -->
                    <StackPanel x:Name="ShortcutSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Settings_ShortcutsTitle}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{DynamicResource Settings_ShortcutsDesc}"
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Info-Box -->
                        <Border Background="#1E3A5F"
                                BorderBrush="#2196F3"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" 
                                          FontSize="20"
                                          FontWeight="Bold"
                                          Foreground="#2196F3"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"/>
                                <TextBlock TextWrapping="Wrap"
                                          Foreground="#B0E0FF"
                                          FontSize="12">
                                    <Run Text="{DynamicResource Settings_ShortcutsInfo}"/>
                                    <Run Text=" "/>
                                    <Run Text="{DynamicResource Settings_ShortcutsPath}" FontWeight="SemiBold"/>
                                    <LineBreak/>
                                    <Run Text="{DynamicResource Settings_ShortcutsHint}" Foreground="#808080"/>
                                    <Run Text=" "/>
                                    <Run Text="{DynamicResource Settings_ShortcutsKey}" FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" "/>
                                    <Run Text="{DynamicResource Settings_ShortcutsQuickAccess}" Foreground="#808080"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Background="#252525"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_QuickActions}"
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          Foreground="White"
                                          Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Shortcut Manager öffnen -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                                        <TextBlock Text="{DynamicResource Settings_ShortcutManager}" 
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="#E0E0E0"/>
                                        <TextBlock Text="{DynamicResource Settings_ShortcutManagerDesc}"
                                                  FontSize="12"
                                                  Foreground="#808080"
                                                  TextWrapping="Wrap"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Content="{DynamicResource Settings_OpenManager}"
                                            x:Name="OpenShortcutManagerButton"
                                            Style="{DynamicResource FluentTabButtonStyle}"
                                            Padding="20,8"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,15"/>

                                    <!-- Shortcuts exportieren -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                                        <TextBlock Text="{DynamicResource Settings_ExportConfig}" 
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="#E0E0E0"/>
                                        <TextBlock Text="{DynamicResource Settings_ExportConfigDesc}"
                                                  FontSize="12"
                                                  Foreground="#808080"
                                                  TextWrapping="Wrap"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="{DynamicResource Settings_Export}"
                                            Style="{DynamicResource FluentTabButtonStyle}"
                                            Padding="20,8"
                                            Background="#757575"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,15"/>

                                    <!-- Shortcuts zurücksetzen -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Settings_ResetToDefault}" 
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="#E0E0E0"/>
                                        <TextBlock Text="{DynamicResource Settings_ResetToDefaultDesc}"
                                                  FontSize="12"
                                                  Foreground="#808080"
                                                  TextWrapping="Wrap"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="2" Grid.Column="1"
                                            Content="{DynamicResource Settings_ResetButton}"
                                            Style="{DynamicResource FluentTabButtonStyle}"
                                            Padding="20,8"
                                            Background="#F44336"
                                            Foreground="White"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Management Panel -->
                    <StackPanel x:Name="WindowManagementPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Settings_WindowMgmtTitle}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{DynamicResource Settings_WindowMgmtDesc}"
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,20"/>

                        <!-- Global Settings -->
                        <Border Background="#252525" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_GlobalSettings}" 
                                          FontSize="16" 
                                          FontWeight="SemiBold" 
                                          Foreground="White" 
                                          Margin="0,0,0,15"/>

                                <!-- Restore on Startup -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Settings_RestoreOnStartup}" 
                                                  Style="{StaticResource SettingsLabelStyle}"/>
                                        <TextBlock Text="{DynamicResource Settings_RestoreOnStartupDesc}" 
                                                  Style="{StaticResource SettingsDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" 
                                                  x:Name="RestoreOnStartupToggle"
                                                  Style="{StaticResource SettingsToggleStyle}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Auto Save -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Settings_AutoSave}" 
                                                  Style="{StaticResource SettingsLabelStyle}"/>
                                        <TextBlock Text="{DynamicResource Settings_AutoSaveDesc}" 
                                                  Style="{StaticResource SettingsDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" 
                                                  x:Name="AutoSaveToggle"
                                                  Style="{StaticResource SettingsToggleStyle}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Support Multiple Instances -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Settings_MultipleInstances}" 
                                                  Style="{StaticResource SettingsLabelStyle}"/>
                                        <TextBlock Text="{DynamicResource Settings_MultipleInstancesDesc}" 
                                                  Style="{StaticResource SettingsDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" 
                                                  x:Name="SupportMultipleInstancesToggle"
                                                  Style="{StaticResource SettingsToggleStyle}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Max Window Count -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Settings_MaxWindowCount}" 
                                                  Style="{StaticResource SettingsLabelStyle}"/>
                                        <TextBlock Text="{DynamicResource Settings_MaxWindowCountDesc}" 
                                                  Style="{StaticResource SettingsDescriptionStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" 
                                             x:Name="MaxWindowCountTextBox"
                                             VerticalAlignment="Center"
                                             Padding="8,6"
                                             FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Statistics -->
                        <Border Background="#1E3A5F" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings_SavedWindows}" Foreground="#808080" FontSize="11"/>
                                    <TextBlock x:Name="SavedWindowsCountText" 
                                              Text="0" 
                                              Foreground="White" 
                                              FontSize="24" 
                                              FontWeight="Bold" 
                                              Margin="0,5,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Settings_ActiveWindows}" Foreground="#808080" FontSize="11"/>
                                    <TextBlock x:Name="TrackedWindowsCountText" 
                                              Text="0" 
                                              Foreground="White" 
                                              FontSize="24" 
                                              FontWeight="Bold" 
                                              Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Window List -->
                        <TextBlock Text="{DynamicResource Settings_WindowList}" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="White" 
                                  Margin="0,0,0,10"/>

                        
                        <Border Background="#1E1E1E" 
                                BorderBrush="#3A3A3A" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="10"
                                MaxHeight="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="WindowListControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" 
                                                    Padding="10,8" 
                                                    Margin="0,2" 
                                                    CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2A2A2A"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Window ID -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding WindowId}" 
                                                                  FontWeight="SemiBold" 
                                                                  Foreground="White" 
                                                                  TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10" Foreground="#808080">
                                                            <Run Text="{DynamicResource Settings_Updated}"/>
                                                            <Run Text=": "/>
                                                            <Run Text="{Binding LastUpdated, StringFormat='{}{0:dd.MM.yy HH:mm}', Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Details -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#3A3A3A" CornerRadius="3" Padding="8,4" Margin="0,0,5,0">
                                                            <TextBlock FontSize="11" Foreground="#B0B0B0">
                                                                <Run Text="{DynamicResource Settings_Position}"/>
                                                                <Run Text=": "/>
                                                                <Run Text="{Binding Left, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                                                                <Run Text=", "/>
                                                                <Run Text="{Binding Top, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Background="#3A3A3A" CornerRadius="3" Padding="8,4" Margin="0,0,5,0">
                                                            <TextBlock FontSize="11" Foreground="#B0B0B0">
                                                                <Run Text="{DynamicResource Settings_Size}"/>
                                                                <Run Text=": "/>
                                                                <Run Text="{Binding Width, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                                                                <Run Text=" x "/>
                                                                <Run Text="{Binding Height, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>

                                                        <Border Background="#4A4A6A" CornerRadius="3" Padding="8,4">
                                                            <TextBlock Text="{Binding WindowState}" 
                                                                      FontSize="11" 
                                                                      Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Actions -->
                                                    <Button Grid.Column="2" 
                                                            Content="✖" 
                                                            Width="30" 
                                                            Height="30"
                                                            Background="Transparent"
                                                            Foreground="#FF6B6B"
                                                            BorderThickness="0"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            ToolTip="{DynamicResource Common_Delete}"
                                                            Tag="{Binding WindowId}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="{DynamicResource Settings_RefreshList2}"
                                    x:Name="RefreshWindowListButton"
                                    Style="{DynamicResource FluentTabButtonStyle}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"/>
                            
                            <Button Content="{DynamicResource Settings_ClearAll}"
                                    x:Name="ClearAllWindowsButton"
                                    Style="{DynamicResource FluentTabButtonStyle}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    Foreground="#FF6B6B"/>
                            
                            <Button Content="{DynamicResource Settings_SaveSettings}"
                                    x:Name="SaveWindowSettingsButton"
                                    Style="{DynamicResource FluentTabButtonStyle}"
                                    Padding="12,8"
                                    Background="#4CAF50"
                                    Foreground="White"/>
                        </StackPanel>
                    </StackPanel>


                    <!-- Language Settings Panel -->
                    <StackPanel x:Name="LanguageSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="Sprache / Language" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Waehlen Sie Ihre bevorzugte Sprache fuer die Anwendung."
                                   Foreground="#808080"
                                   FontSize="12"
                                   Margin="0,0,0,20"/>

                        <!-- Current Language Info -->
                        <Border Background="#1E3A5F" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Aktuelle Sprache / Current Language" 
                                          Foreground="#808080" 
                                          FontSize="11" 
                                          Margin="0,0,0,5"/>
                                <TextBlock x:Name="CurrentLanguageText" 
                                          Text="Deutsch (Deutschland)" 
                                          Foreground="White" 
                                          FontSize="18" 
                                          FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Language Selection -->
                        <TextBlock Text="Sprache auswaehlen / Select Language" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="White" 
                                  Margin="0,0,0,15"/>

                        <Border Background="#1E1E1E" 
                                BorderBrush="#3A3A3A" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="0"
                                Margin="0,0,0,20">
                            <StackPanel x:Name="LanguageListPanel">
                                <!-- Deutsch -->
                                <Button x:Name="SelectGermanButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="20,15"
                                        HorizontalContentAlignment="Left"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" 
                                                                Background="{TemplateBinding Background}" 
                                                                BorderThickness="0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Flag Icon -->
                                        <Border Grid.Column="0" Width="40" Height="30" Background="#FFD700" CornerRadius="3" Margin="0,0,15,0">
                                            <TextBlock Text="🇩🇪" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Language Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Deutsch" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="German (Deutschland)" FontSize="11" Foreground="#808080"/>
                                        </StackPanel>
                                        
                                        <!-- Selected Indicator -->
                                        <TextBlock Grid.Column="2" 
                                                  x:Name="GermanSelectedIndicator"
                                                  Text="✓" 
                                                  FontSize="20" 
                                                  FontWeight="Bold" 
                                                  Foreground="#4CAF50" 
                                                  VerticalAlignment="Center"
                                                  Visibility="Visible"/>
                                    </Grid>
                                </Button>

                                <!-- Separator -->
                                <Border Height="1" Background="#3A3A3A" Margin="20,0"/>

                                <!-- English -->
                                <Button x:Name="SelectEnglishButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="20,15"
                                        HorizontalContentAlignment="Left"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" 
                                                                Background="{TemplateBinding Background}" 
                                                                BorderThickness="0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Flag Icon -->
                                        <Border Grid.Column="0" Width="40" Height="30" Background="#002868" CornerRadius="3" Margin="0,0,15,0">
                                            <TextBlock Text="🇺🇸" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Language Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="English" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="English (United States)" FontSize="11" Foreground="#808080"/>
                                        </StackPanel>
                                        
                                        <!-- Selected Indicator -->
                                        <TextBlock Grid.Column="2" 
                                                  x:Name="EnglishSelectedIndicator"
                                                  Text="✓" 
                                                  FontSize="20" 
                                                  FontWeight="Bold" 
                                                  Foreground="#4CAF50" 
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Info Note -->
                        <Border Background="#2A2A2A" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#B0B0B0" FontSize="12">
                                    <Run Text="Hinweis: Die Anwendung wird die neue Sprache sofort uebernehmen."/>
                                    <LineBreak/>
                                    <Run Text="Note: The application will apply the new language immediately."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#252525" 
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#4CAF50"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="{DynamicResource Settings_SaveSettings}"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{DynamicResource FluentTabButtonStyle}"
                        Padding="20,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

