<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zenox.Maui.UI.Views.AnzeigeEinstellungenView">
    <StackLayout Padding="20" Spacing="16">
        <Label Text="Anzeige-Einstellungen" FontAttributes="Bold" FontSize="20" />
        <Picker Title="Sortierreihenfolge" ItemsSource="{Binding SortOrders}" SelectedItem="{Binding AnzeigeEinstellungen.SortOrder}" />
        <Switch IsToggled="{Binding AnzeigeEinstellungen.ShowCategories}" />
        <Label Text="Kategorien anzeigen" />
        <Picker Title="Theme" ItemsSource="{Binding Themes}" SelectedItem="{Binding AnzeigeEinstellungen.Theme}" />
    </StackLayout>
</ContentPage>