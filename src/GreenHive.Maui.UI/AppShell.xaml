<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GreenHive.Maui.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GreenHive.Maui.UI"
    xmlns:pages="clr-namespace:GreenHive.Maui.UI.Pages"
    Title="GreenHive.Maui.UI"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="🏠 Start"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Route="home" />

        <ShellContent
            Title="📊 Daten"
            ContentTemplate="{DataTemplate pages:DataPage}"
            Route="data" />

        <ShellContent
            Title="✏️ Bearbeiten"
            ContentTemplate="{DataTemplate pages:EditPage}"
            Route="edit" />

        <ShellContent
            Title="🔧 Werkzeuge"
            ContentTemplate="{DataTemplate pages:ToolsPage}"
            Route="tools" />

        <ShellContent
            Title="❓ Hilfe"
            ContentTemplate="{DataTemplate pages:HelpPage}"
            Route="help" />
    </TabBar>

</Shell>
