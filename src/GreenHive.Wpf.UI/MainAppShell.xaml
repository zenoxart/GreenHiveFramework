<Window x:Class="GreenHive.Wpf.UI.MainAppShell"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:GreenHive.Wpf.UI"
		xmlns:notifications="clr-namespace:GreenHive.Wpf.Controls.Common.Notifications;assembly=GreenHive.Wpf.Controls"
		xmlns:heatmap="clr-namespace:GreenHive.Wpf.Controls.Common.Heatmap;assembly=GreenHive.Wpf.Controls"
		mc:Ignorable="d"
		Title="WPF Prototyp"
		MinHeight="300"
		MinWidth="800"
		>
	<Grid heatmap:HeatmapTrackingBehavior.IsTrackingEnabled="True"
		  heatmap:HeatmapTrackingBehavior.ViewName="MainAppShell"
		  heatmap:HeatmapTrackingBehavior.TrackClicks="True"
		  heatmap:HeatmapTrackingBehavior.TrackHover="True"
		  heatmap:HeatmapTrackingBehavior.TrackScroll="True">
		<ContentControl x:Name="MainModul"/>
		
		<!-- Notification Container - Always on top -->
		<notifications:NotificationContainer Panel.ZIndex="9999"/>
	</Grid>
</Window>
