{
  // Static routes of the platform services (Docker host names). Module backend routes come from the Module Registry.
  "GreenHive": {
    "Routes": {
      "/api/identity": "http://identity-service:8080",
      "/api/config": "http://configuration-service:8080",
      "/api/modules": "http://module-registry:8080",
      "/api/packages": "http://module-delivery:8080",
      "/api/updates": "http://update-orchestrator:8080",
      "/api/notifications": "http://notification-point:8080",
      "/api/workflows": "http://workflow-service:8080",
      "/api/ai": "http://ai-agent-service:8080"
    },
    "RateLimitPerMinute": 1200
  },
  "AllowedHosts": "*"
}
