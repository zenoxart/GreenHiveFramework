<Window x:Class="GreenHive.Wpf.Controls.Common.CommandReplay.CommandHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenHive.Wpf.Controls.Common.CommandReplay"
        mc:Ignorable="d"
        Title="Befehlsverlauf und Wiedergabe"
        Height="700" Width="1000"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Befehlsverlauf und Wiedergabe" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#FFFFFF" 
                   Margin="0,0,0,10"/>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <CheckBox x:Name="RecordingCheckBox" 
                      Content="Aufnahme aktiv" 
                      IsChecked="True"
                      Checked="RecordingCheckBox_Changed"
                      Unchecked="RecordingCheckBox_Changed"/>
            <TextBlock Text=" | Befehle: " Foreground="#8A8A8A" FontSize="14" Margin="15,0,0,0"/>
            <TextBlock x:Name="CommandCountText" Text="0" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="5,0"/>
            <TextBlock Text=" | Ausgewählt: " Foreground="#8A8A8A" FontSize="14" Margin="15,0,0,0"/>
            <TextBlock x:Name="SelectedCountText" Text="0" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="5,0"/>
        </StackPanel>

        <!-- Command History -->
        <DataGrid x:Name="CommandHistoryGrid" 
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  Background="Transparent"
                  BorderThickness="0"
                  RowBackground="#2D2D2D"
                  AlternatingRowBackground="#252525"
                  Foreground="#FFFFFF"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  SelectionChanged="CommandHistoryGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeitstempel" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="100"/>
                <DataGridTextColumn Header="Befehl" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Dauer (ms)" Binding="{Binding DurationMs}" Width="100"/>
                <DataGridTemplateColumn Header="Status" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Success, Converter={StaticResource BoolToStatusConverter}}" 
                                       Foreground="{Binding Success, Converter={StaticResource BoolToColorConverter}}"
                                       FontWeight="Bold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="▶️ Ausgewählte wiedergeben" Click="ReplaySelected_Click"/>
                <Button Content="💾 Sequenz speichern" Click="SaveSequence_Click"/>
                <Button Content="📂 Sequenz laden" Click="LoadSequence_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🗑️ Verlauf löschen" Click="ClearHistory_Click" Background="#E81123"/>
                <Button Content="Schließen" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
