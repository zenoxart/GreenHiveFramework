<UserControl x:Class="GreenHive.Wpf.Controls.Common.PerformanceMonitor.PerformancePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GreenHive.Wpf.Controls.Common.PerformanceMonitor"
             xmlns:heatmap="clr-namespace:GreenHive.Wpf.Controls.Common.Heatmap"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="PerformanceTabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FluentWindowBackground}">
        <TabControl Background="Transparent"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource PerformanceTabStyle}"/>
            </TabControl.Resources>

            <!-- Performance Monitor Tab -->
            <TabItem Header="{DynamicResource Performance_Monitor}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource Performance_Monitor}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{DynamicResource Performance_MonitorDesc}"
                                   Foreground="#808080"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Performance Overlay -->
                    <local:PerformanceOverlay Grid.Row="1" 
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"/>
                </Grid>
            </TabItem>

            <!-- Interaction Heatmap Tab -->
            <TabItem Header="{DynamicResource Performance_Heatmap}">
                <heatmap:InteractionHeatmapView/>
            </TabItem>

            <!-- Telemetry Events Tab -->
            <TabItem Header="{DynamicResource Performance_Telemetry}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource Performance_TelemetryEvents}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{DynamicResource Performance_TelemetryDesc}"
                                   Foreground="#808080"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>


                    <!-- Events List -->
                    <Border Grid.Row="1" 
                            Background="#1E1E1E" 
                            BorderBrush="#3A3A3A" 
                            BorderThickness="1"
                            CornerRadius="6">
                        <ListBox x:Name="EventsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2A2A" 
                                            CornerRadius="4" 
                                            Padding="12,8" 
                                            Margin="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                    Background="#4A4A6A" 
                                                    CornerRadius="4" 
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Category}" 
                                                           Foreground="White" 
                                                           FontSize="10"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding EventName}" 
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                                       Foreground="#606060"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
