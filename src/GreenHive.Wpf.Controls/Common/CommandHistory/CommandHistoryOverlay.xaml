<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GreenHive.Wpf.Controls.Common.CommandHistory.CommandHistoryOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GreenHive.Wpf.Controls.Common.CommandHistory"
        Title="Command History"
        Width="650"
        Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <local:TimestampConverter x:Key="TimestampConverter"/>
        <local:SuccessToColorConverter x:Key="SuccessToColorConverter"/>
        <local:TextLengthToVisibilityConverter x:Key="TextLengthToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8,8,0,0">
                            <Grid>
                                <TextBlock Text="Suche in Command-Historie..."
                                           Foreground="#808080"
                                           FontSize="{TemplateBinding FontSize}"
                                           Padding="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TextLengthToVisibilityConverter}}"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="HistoryListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Indicator -->
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{Binding Success, Converter={StaticResource SuccessToColorConverter}}"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>

                                <!-- Command Info -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11"
                                                   Foreground="#FFA726"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding DurationMs, StringFormat='{}{0}ms'}"
                                                   FontSize="11"
                                                   Foreground="#81C784"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Timestamp, Converter={StaticResource TimestampConverter}}"
                                           FontSize="11"
                                           Foreground="#808080"
                                           VerticalAlignment="Center"
                                           Margin="10,0"/>

                                <!-- Replay Icon -->
                                <TextBlock Grid.Column="3"
                                           Text="&#x25B6;"
                                           FontSize="10"
                                           Foreground="#808080"
                                           VerticalAlignment="Center"
                                           ToolTip="Enter zum Wiederholen"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0078D4"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Indicator" Width="8" Height="8" Fill="#808080" Margin="0,0,6,0"/>
                                <TextBlock x:Name="Text" Text="REC" FontSize="11" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Fill" Value="#FF4444"/>
                                <Setter TargetName="Text" Property="Foreground" Value="#FF4444"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" FontSize="14"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#404040">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="#2D2D2D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,8">
                    <TextBlock Text="&#x1F4DC;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Command History" FontSize="13" FontWeight="SemiBold" 
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,8,4"/>

                <!-- Recording Toggle -->
                <ToggleButton Grid.Column="2"
                              Style="{StaticResource ToggleButtonStyle}"
                              IsChecked="{Binding IsRecording}"
                              ToolTip="Aufzeichnung an/aus"
                              Margin="0,0,8,0"/>

                <!-- Close Button -->
                <Button Grid.Column="3"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"
                        Margin="0,0,8,0"
                        ToolTip="Schliessen (Esc)"/>
            </Grid>

            <!-- Command List -->
            <ListBox x:Name="HistoryList"
                     Grid.Row="1"
                     Style="{StaticResource HistoryListBoxStyle}"
                     ItemContainerStyle="{StaticResource HistoryListBoxItemStyle}"
                     ItemsSource="{Binding FilteredCommands}"
                     SelectedItem="{Binding SelectedItem}"
                     MouseDoubleClick="HistoryList_MouseDoubleClick"/>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#2D2D2D"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#404040"
                    Padding="12,8"
                    CornerRadius="0,0,8,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Foreground="#808080" FontSize="11" Text="Up/Down Navigieren  "/>
                        <TextBlock Foreground="#808080" FontSize="11" Text="Enter Wiederholen  "/>
                        <TextBlock Foreground="#808080" FontSize="11" Text="Esc Schliessen  "/>
                        <TextBlock Foreground="#0078D4" FontSize="11" Text="Ctrl+Shift+H"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="#808080"
                               FontSize="11"
                               Text="{Binding FilteredCommands.Count, StringFormat='{}{0} Commands'}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
