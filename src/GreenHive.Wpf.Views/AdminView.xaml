<UserControl x:Class="GreenHive.Wpf.Views.AdminView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:tutorial="clr-namespace:GreenHive.NET.Core.Common.Tutorial;assembly=GreenHive.Wpf.Advanced"
			 xmlns:local="clr-namespace:GreenHive.Wpf.Views"
			 mc:Ignorable="d"
			 d:DesignHeight="450"
			 d:DesignWidth="800"
			 Name="Administration">
	<Grid Background="{DynamicResource FluentWindowBackground}">
        <StackPanel Margin="20">
            <TextBlock Text="Administration"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FluentTextBrush}"
                       tutorial:TutorialHelper.TutorialKey="AdminTitle"
                       Margin="0,0,0,20"/>
            
            <TextBlock Text="Dies ist der Administrationsbereich der Anwendung."
                       Foreground="{DynamicResource FluentTextBrush}"
                       tutorial:TutorialHelper.TutorialKey="AdminDescription"
                       Margin="0,0,0,20"/>
            
            <Button Content="Einstellungen verwalten"
                    tutorial:TutorialHelper.TutorialKey="SettingsButton"
                    Style="{DynamicResource FluentTabButtonStyle}"
                    Padding="15,10"
                    Margin="0,0,0,10"/>
            
            <Button Content="Benutzer verwalten"
                    tutorial:TutorialHelper.TutorialKey="UserButton"
                    Style="{DynamicResource FluentTabButtonStyle}"
                    Padding="15,10"
                    Margin="0,0,0,10"/>
            
            <Button Content="Admin-Aktionen"
                    tutorial:TutorialHelper.TutorialKey="AdminActionsButton"
                    Style="{DynamicResource FluentTabButtonStyle}"
                    Padding="15,10"
                    Margin="0,0,0,10"/>

			<TextBlock Text="{Binding AdminView.Status}" />

		</StackPanel>
    </Grid>
</UserControl>
