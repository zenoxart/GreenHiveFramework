<UserControl x:Class="Voestalpine.Wpf.Controls.Common.TabView.TabViewControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:converters="clr-namespace:Voestalpine.Wpf.Controls.Common.TabView.Converters"
			 xmlns:local="clr-namespace:Voestalpine.Wpf.Controls.Common.TabView"
			 mc:Ignorable="d"
			 d:DesignHeight="450"
			 d:DesignWidth="800">
	
	<UserControl.Resources>
		<converters:PinIconConverter x:Key="PinIconConverter"/>
		<converters:PinTooltipConverter x:Key="PinTooltipConverter"/>
		<converters:PinMenuHeaderConverter x:Key="PinMenuHeaderConverter"/>
		<converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
		
		<!-- Fluent UI Colors -->
		<SolidColorBrush x:Key="FluentBackgroundBrush" Color="#F3F2F1"/>
		<SolidColorBrush x:Key="FluentTabBackgroundBrush" Color="White"/>
		<SolidColorBrush x:Key="FluentTabHoverBrush" Color="#F9F9F9"/>
		<SolidColorBrush x:Key="FluentBorderBrush" Color="#E1DFDD"/>
		<SolidColorBrush x:Key="FluentTextBrush" Color="#323130"/>
		<SolidColorBrush x:Key="FluentAccentBrush" Color="#0078D4"/>
		<SolidColorBrush x:Key="FluentButtonHoverBrush" Color="#F3F2F1"/>
	</UserControl.Resources>
	
	<TabControl x:Name="tabControl"
				SelectedIndex="0"
				Background="{StaticResource FluentBackgroundBrush}"
				BorderThickness="0"
				ItemsSource="{Binding TabItems, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}">
		<TabControl.ItemContainerStyle>
			<Style TargetType="TabItem">
				<Setter Property="Content" Value="{Binding Content}" />
				<Setter Property="FontFamily" Value="Segoe UI"/>
				<Setter Property="FontSize" Value="14"/>
				<Setter Property="Foreground" Value="{StaticResource FluentTextBrush}"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1,1,1,0"/>
				<Setter Property="Margin" Value="0,0,2,0"/>
				<Setter Property="Padding" Value="0"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="TabItem">
							<Border x:Name="TabBorder"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="8,8,0,0"
									Margin="{TemplateBinding Margin}">
								<ContentPresenter ContentSource="Header"
												  HorizontalAlignment="Stretch"
												  VerticalAlignment="Stretch"
												  Margin="0"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="TabBorder" Property="Background" Value="{StaticResource FluentTabBackgroundBrush}"/>
									<Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
									<Setter Property="Panel.ZIndex" Value="2"/>
									<Setter Property="Margin" Value="0,0,2,-1"/>
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="TabBorder" Property="Background" Value="{StaticResource FluentTabHoverBrush}"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter Property="HeaderTemplate">
					<Setter.Value>
						<DataTemplate>
							<Grid MinHeight="36" MinWidth="120">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								
								<!-- Pin Button -->
								<Button Grid.Column="0" 
										Width="24" 
										Height="24" 
										Margin="8,6,4,6"
										Background="Transparent"
										BorderThickness="0"
										Content="{Binding IsPinned, Converter={StaticResource PinIconConverter}}"
										FontSize="12"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Command="{Binding TogglePinCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
										CommandParameter="{Binding}"
										ToolTip="{Binding IsPinned, Converter={StaticResource PinTooltipConverter}}"
										Opacity="0.7"
										Cursor="Hand">
									<Button.Style>
										<Style TargetType="Button">
											<Style.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter Property="Background" Value="{StaticResource FluentButtonHoverBrush}"/>
													<Setter Property="Opacity" Value="1"/>
												</Trigger>
												<DataTrigger Binding="{Binding IsPinned}" Value="True">
													<Setter Property="Foreground" Value="{StaticResource FluentAccentBrush}"/>
													<Setter Property="Opacity" Value="1"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
								</Button>
								
								<!-- Tab Title -->
								<TextBlock Grid.Column="1" 
										   Text="{Binding Name}" 
										   VerticalAlignment="Center"
										   FontFamily="Segoe UI"
										   FontSize="14"
										   Margin="4,8,8,8"
										   TextTrimming="CharacterEllipsis"
										   Foreground="{StaticResource FluentTextBrush}">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsPinned}" Value="True">
													<Setter Property="FontWeight" Value="SemiBold"/>
													<Setter Property="Foreground" Value="{StaticResource FluentAccentBrush}"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								
								<!-- Close Button -->
								<Button Grid.Column="2" 
										Width="24" 
										Height="24" 
										Margin="4,6,8,6"
										Background="Transparent"
										BorderThickness="0"
										Content="✕"
										FontSize="12"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Command="{Binding CloseTabCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
										CommandParameter="{Binding}"
										ToolTip="Close Tab"
										IsEnabled="{Binding IsPinned, Converter={StaticResource InverseBoolConverter}}"
										Opacity="0.7"
										Cursor="Hand">
									<Button.Style>
										<Style TargetType="Button">
											<Style.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter Property="Background" Value="{StaticResource FluentButtonHoverBrush}"/>
													<Setter Property="Foreground" Value="#D13438"/>
													<Setter Property="Opacity" Value="1"/>
												</Trigger>
												<DataTrigger Binding="{Binding IsPinned}" Value="True">
													<Setter Property="Opacity" Value="0.3"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
								</Button>
								
								<!-- Context Menu -->
								<Grid.ContextMenu>
									<ContextMenu Background="White"
												 BorderBrush="{StaticResource FluentBorderBrush}"
												 BorderThickness="1"
												 HasDropShadow="True">
										<MenuItem Header="{Binding IsPinned, Converter={StaticResource PinMenuHeaderConverter}}" 
												  Command="{Binding TogglePinCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
												  CommandParameter="{Binding}"/>
										<Separator/>
										<MenuItem Header="Close Tab" 
												  Command="{Binding CloseTabCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
												  CommandParameter="{Binding}"
												  IsEnabled="{Binding IsPinned, Converter={StaticResource InverseBoolConverter}}"/>
										<Separator/>
										<MenuItem Header="Close All Other Tabs" 
												  Command="{Binding CloseAllOtherTabsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Close All Unpinned Tabs" 
												  Command="{Binding CloseAllUnpinnedTabsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Close All Tabs to the Right" 
												  Command="{Binding CloseAllTabsToRightCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
												  CommandParameter="{Binding}"/>
									</ContextMenu>
								</Grid.ContextMenu>
							</Grid>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</TabControl.ItemContainerStyle>
	</TabControl>
</UserControl>
