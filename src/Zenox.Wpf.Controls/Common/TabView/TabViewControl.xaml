<UserControl x:Class="Zenox.Wpf.Controls.Common.TabView.TabViewControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:converters="clr-namespace:Zenox.Wpf.Controls.Common.TabView.Converters"
			 xmlns:local="clr-namespace:Zenox.Wpf.Controls.Common.TabView"
			 mc:Ignorable="d"
			 d:DesignHeight="450"
			 d:DesignWidth="800">

	<!-- Converter Resources -->
	<UserControl.Resources>
		<converters:PinIconConverter x:Key="PinIconConverter" />
		<converters:PinTooltipConverter x:Key="PinTooltipConverter" />
		<converters:PinMenuHeaderConverter x:Key="PinMenuHeaderConverter" />
		<converters:InverseBoolConverter x:Key="InverseBoolConverter" />
	</UserControl.Resources>

	<TabControl x:Name="tabControl"
				SelectedIndex="0"
				Background="{StaticResource FluentTabControlBackground}"
				Foreground="{StaticResource FluentTextBrush}"
				BorderThickness="0"
				FontFamily="Segoe UI"
				ItemsSource="{Binding TabItems, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}">

		<!-- Custom TabControl Template for better system theme integration -->
		<TabControl.Template>
			<ControlTemplate TargetType="TabControl">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!-- Tab Headers -->
					<Border Grid.Row="0"
							Background="{StaticResource FluentTabControlBackground}"
							BorderBrush="{StaticResource FluentBorderBrush}"
							BorderThickness="0,0,0,1"
							Padding="12,8,12,0">
						<TabPanel x:Name="HeaderPanel"
								  IsItemsHost="True"
								  Panel.ZIndex="1" />
					</Border>

					<!-- Content Area -->
					<Border Grid.Row="1"
							Background="{StaticResource FluentTabBackground}"
							BorderBrush="{StaticResource FluentBorderBrush}"
							BorderThickness="1,0,1,1"
							CornerRadius="0,0,8,8">
						<ContentPresenter x:Name="PART_SelectedContentHost"
										  ContentSource="SelectedContent"
										  Margin="16" />
					</Border>
				</Grid>
			</ControlTemplate>
		</TabControl.Template>

		<TabControl.ItemContainerStyle>
			<Style TargetType="TabItem">
				<Setter Property="Content"
						Value="{Binding Content}" />
				<Setter Property="FontFamily"
						Value="Segoe UI" />
				<Setter Property="FontSize"
						Value="14" />
				<Setter Property="Foreground"
						Value="{StaticResource FluentTextBrush}" />
				<Setter Property="Background"
						Value="Transparent" />
				<Setter Property="BorderBrush"
						Value="{StaticResource FluentBorderBrush}" />
				<Setter Property="BorderThickness"
						Value="1,1,1,0" />
				<Setter Property="Margin"
						Value="0,0,2,0" />
				<Setter Property="MinHeight"
						Value="40" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="TabItem">
							<Border x:Name="Border"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="8,8,0,0"
									Margin="{TemplateBinding Margin}">
								<ContentPresenter x:Name="ContentSite"
												  ContentSource="Header"
												  HorizontalAlignment="Stretch"
												  VerticalAlignment="Stretch"
												  Margin="0" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsSelected"
										 Value="True">
									<Setter TargetName="Border"
											Property="Background"
											Value="{StaticResource FluentTabSelectedBackground}" />
									<Setter TargetName="Border"
											Property="BorderBrush"
											Value="{StaticResource FluentAccentBrush}" />
									<Setter Property="Panel.ZIndex"
											Value="2" />
									<Setter Property="Margin"
											Value="0,0,2,-1" />
								</Trigger>
								<MultiTrigger>
									<MultiTrigger.Conditions>
										<Condition Property="IsMouseOver"
												   Value="True" />
										<Condition Property="IsSelected"
												   Value="False" />
									</MultiTrigger.Conditions>
									<Setter TargetName="Border"
											Property="Background"
											Value="{StaticResource FluentTabHoverBackground}" />
								</MultiTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				
				<Setter Property="HeaderTemplate">
					<Setter.Value>
						<DataTemplate>
							<Grid MinHeight="36"
								  MinWidth="120">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<!-- Pin Button -->
								<Button Grid.Column="0"
										Width="24"
										Height="24"
										Margin="8,6,4,6"
										Background="Transparent"
										Foreground="{StaticResource FluentTextBrush}"
										BorderThickness="0"
										Content="{Binding IsPinned, Converter={StaticResource PinIconConverter}}"
										FontSize="12"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Command="{Binding TogglePinCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
										CommandParameter="{Binding}"
										ToolTip="{Binding IsPinned, Converter={StaticResource PinTooltipConverter}}"
										Cursor="Hand"
										Opacity="0.7">
									<Button.Style>
										<Style TargetType="Button">
											<Style.Triggers>
												<Trigger Property="IsMouseOver"
														 Value="True">
													<Setter Property="Opacity"
															Value="1" />
													<Setter Property="Background"
															Value="{StaticResource FluentButtonHoverBrush}" />
												</Trigger>
												<DataTrigger Binding="{Binding IsPinned}"
															 Value="True">
													<Setter Property="Opacity"
															Value="1" />
													<Setter Property="Foreground"
															Value="{StaticResource FluentAccentBrush}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
								</Button>

								<!-- Tab Title -->
								<TextBlock Grid.Column="1"
										   Text="{Binding Name}"
										   VerticalAlignment="Center"
										   FontFamily="Segoe UI"
										   FontSize="14"
										   FontWeight="Normal"
										   Margin="6,6,8,6"
										   TextTrimming="CharacterEllipsis"
										   Foreground="{StaticResource FluentTextBrush}">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsPinned}"
															 Value="True">
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Foreground"
															Value="{StaticResource FluentAccentBrush}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>

								<!-- Close Button -->
								<Button Grid.Column="2"
										Width="24"
										Height="24"
										Margin="4,6,8,6"
										Background="Transparent"
										Foreground="{StaticResource FluentTextBrush}"
										BorderThickness="0"
										Content="✕"
										FontSize="12"
										FontWeight="Normal"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Command="{Binding CloseTabCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
										CommandParameter="{Binding}"
										ToolTip="Close Tab"
										IsEnabled="{Binding IsPinned, Converter={StaticResource InverseBoolConverter}}"
										Cursor="Hand"
										Opacity="0.7">
									<Button.Style>
										<Style TargetType="Button">
											<Style.Triggers>
												<Trigger Property="IsMouseOver"
														 Value="True">
													<Setter Property="Opacity"
															Value="1" />
													<Setter Property="Background"
															Value="{StaticResource FluentButtonHoverBrush}" />
													<Setter Property="Foreground"
															Value="#C42B1C" />
												</Trigger>
												<DataTrigger Binding="{Binding IsPinned}"
															 Value="True">
													<Setter Property="Opacity"
															Value="0.3" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
								</Button>

								<!-- Context Menu (fix: move to TabItem style) -->
							</Grid>
						</DataTemplate>
					</Setter.Value>
				</Setter>
				
				<Setter Property="ContextMenu">
					<Setter.Value>
						<ContextMenu Background="{StaticResource FluentTabBackground}"
									 Foreground="{StaticResource FluentTextBrush}"
									 BorderBrush="{StaticResource FluentBorderBrush}"
									 BorderThickness="1"
									 HasDropShadow="True"
									 Padding="4">
							<ContextMenu.Resources>
								<Style TargetType="MenuItem">
									<Setter Property="FontFamily"
											Value="Segoe UI" />
									<Setter Property="FontSize"
											Value="14" />
									<Setter Property="Foreground"
											Value="{StaticResource FluentTextBrush}" />
									<Setter Property="Padding"
											Value="12,8" />
									<Setter Property="Height"
											Value="36" />
									<Style.Triggers>
										<Trigger Property="IsHighlighted"
												 Value="True">
											<Setter Property="Background"
													Value="{StaticResource FluentButtonHoverBrush}" />
										</Trigger>
									</Style.Triggers>
								</Style>
								<Style TargetType="Separator">
									<Setter Property="Background"
											Value="{StaticResource FluentBorderBrush}" />
									<Setter Property="Height"
											Value="1" />
									<Setter Property="Margin"
											Value="8,4" />
								</Style>
							</ContextMenu.Resources>
							<MenuItem Header="{Binding IsPinned, Converter={StaticResource PinMenuHeaderConverter}}"
									  Command="{Binding TogglePinCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
									  CommandParameter="{Binding}" />
							<Separator />
							<MenuItem Header="Close Tab"
									  Command="{Binding CloseTabCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
									  CommandParameter="{Binding}"
									  IsEnabled="{Binding IsPinned, Converter={StaticResource InverseBoolConverter}}" />
							<Separator />
							<MenuItem Header="Close All Other Tabs"
									  Command="{Binding CloseAllOtherTabsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
									  CommandParameter="{Binding}" />
							<MenuItem Header="Close All Unpinned Tabs"
									  Command="{Binding CloseAllUnpinnedTabsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
									  CommandParameter="{Binding}" />
							<MenuItem Header="Close All Tabs to the Right"
									  Command="{Binding CloseAllTabsToRightCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabViewControl}}}"
									  CommandParameter="{Binding}" />
						</ContextMenu>
					</Setter.Value>
				</Setter>

			</Style>
		</TabControl.ItemContainerStyle>
	</TabControl>
</UserControl>
