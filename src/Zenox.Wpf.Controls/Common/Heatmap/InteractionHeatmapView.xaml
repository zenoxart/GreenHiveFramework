<UserControl x:Class="Zenox.Wpf.Controls.Common.Heatmap.InteractionHeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Zenox.Wpf.Controls.Common.Heatmap"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <local:InteractionHeatmapViewModel x:Key="HeatmapVM"/>
        <local:IntensityToColorConverter x:Key="IntensityConverter"/>

        <Style x:Key="HeatmapToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="13" Padding="3">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeatmapLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E" DataContext="{StaticResource HeatmapVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252525" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Interaction Heatmap" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Visualisiert Benutzerinteraktionen" Foreground="#808080" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tracking:" Style="{StaticResource HeatmapLabelStyle}" Margin="0,0,10,0"/>
                    <ToggleButton IsChecked="{Binding IsTracking}" Style="{StaticResource HeatmapToggleStyle}"/>
                    <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Padding="12,6" Margin="15,0,0,0" Background="#2D2D2D" Foreground="White" BorderBrush="#404040"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="15,10">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Interaktionen" Foreground="#808080" FontSize="10"/>
                        <TextBlock Text="{Binding Statistics.TotalInteractions}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Klicks" Foreground="#808080" FontSize="10"/>
                        <TextBlock Text="{Binding Statistics.ClickCount}" Foreground="#4CAF50" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Hovers" Foreground="#808080" FontSize="10"/>
                        <TextBlock Text="{Binding Statistics.HoverCount}" Foreground="#2196F3" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Elemente" Foreground="#808080" FontSize="10"/>
                        <TextBlock Text="{Binding Statistics.UniqueElements}" Foreground="#FF9800" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sessions" Foreground="#808080" FontSize="10"/>
                        <TextBlock Text="{Binding Statistics.SessionCount}" Foreground="#9C27B0" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="15,5,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252525" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zellengroesse:" Style="{StaticResource HeatmapLabelStyle}" Margin="0,0,8,0"/>
                            <Slider Value="{Binding CellSize}" Minimum="5" Maximum="50" Width="100" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CellSize, StringFormat='{}{0}px'}" Style="{StaticResource HeatmapLabelStyle}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding HeatmapCells}" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding GridX, Converter={StaticResource IntensityConverter}, ConverterParameter=Position}"/>
                                <Setter Property="Canvas.Top" Value="{Binding GridY, Converter={StaticResource IntensityConverter}, ConverterParameter=Position}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="{Binding Count, Converter={StaticResource IntensityConverter}, ConverterParameter=Size}" 
                                         Height="{Binding Count, Converter={StaticResource IntensityConverter}, ConverterParameter=Size}" 
                                         Opacity="{Binding Intensity}">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="{Binding Intensity, Converter={StaticResource IntensityConverter}}" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="1" Text="Keine Interaktionen aufgezeichnet" Foreground="#606060" FontSize="14" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Visibility="{Binding HeatmapCells.Count, Converter={StaticResource IntensityConverter}, ConverterParameter=EmptyVisibility}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252525" Padding="12">
                        <TextBlock Text="Top Elemente" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding TopElements}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A2A" CornerRadius="4" Padding="10,8" Margin="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ElementName}" Foreground="White" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ElementType}" Foreground="#606060" FontSize="9"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#4A4A6A" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InteractionCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="#252525" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Tracking-Optionen" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Klicks" Style="{StaticResource HeatmapLabelStyle}"/>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding TrackClicks}" Style="{StaticResource HeatmapToggleStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hover" Style="{StaticResource HeatmapLabelStyle}"/>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding TrackHover}" Style="{StaticResource HeatmapToggleStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Scroll" Style="{StaticResource HeatmapLabelStyle}"/>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding TrackScroll}" Style="{StaticResource HeatmapToggleStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Padding="12">
                        <StackPanel>
                            <Button Content="Neue Session" Command="{Binding NewSessionCommand}" Padding="10,6" Margin="0,0,0,8" HorizontalAlignment="Stretch" Background="#2D2D2D" Foreground="White" BorderBrush="#404040"/>
                            <Button Content="Exportieren" Command="{Binding ExportCommand}" Padding="10,6" Margin="0,0,0,8" HorizontalAlignment="Stretch" Background="#2D2D2D" Foreground="White" BorderBrush="#404040"/>
                            <Button Content="Daten loeschen" Command="{Binding ClearDataCommand}" Padding="10,6" HorizontalAlignment="Stretch" Background="#2D2D2D" Foreground="#FF6B6B" BorderBrush="#404040"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#252525" Padding="15,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#4CAF50" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>