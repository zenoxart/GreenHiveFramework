<UserControl x:Class="Zenox.Wpf.Controls.Common.Menu.LeftMenuControl"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:tutorial="clr-namespace:Zenox.Wpf.Core.Common.Tutorial;assembly=Zenox.Wpf.Core"
			 xmlns:local="clr-namespace:Zenox.Wpf.Controls.Common.Menu"
			 mc:Ignorable="d"
			 d:DesignHeight="450"
			 d:DesignWidth="800">

	<!-- Page Left Menu-->
	<ListView Grid.Row="1"
			  Grid.RowSpan="2"
			  Grid.Column="0"
			  Padding="0,0,0,0"
			  tutorial:TutorialHelper.TutorialKey="LeftMenuItems"
			  BorderThickness="0,0,0,0"
			  ItemsSource="{Binding MyPageLeftMenu, 
                RelativeSource={RelativeSource FindAncestor,
                AncestorType={x:Type local:LeftMenuControl}}}">
		<ListView.ItemContainerStyle>
			<Style TargetType="ListViewItem">
				<Setter Property="Padding"
						Value="0,0,0,0" />
				<Setter Property="Margin"
						Value="5,5,5,0" />
				<Setter Property="Background"
						Value="Transparent" />
				<Setter Property="BorderThickness"
						Value="0,0,0,0" />

				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListViewItem">
							<StackPanel Orientation="Vertical">
								<ContentPresenter Margin="0,0,0,0" />
							</StackPanel>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ListView.ItemContainerStyle>
		<ListView.ItemTemplate>
			<DataTemplate>
				<Button Command="{Binding Command}"
						tutorial:TutorialHelper.TutorialKey="{Binding Name, StringFormat='LeftMenu_{0}'}"
						Padding="12,8,12,8"
						Margin="2,2,2,2"
						FontFamily="Segoe UI"
						FontSize="14"
						Foreground="{DynamicResource FluentTextBrush}"
						Background="Transparent"
						BorderThickness="0"
						BorderBrush="{DynamicResource FluentBorderBrush}"
						HorizontalAlignment="Left"
						Cursor="Hand">
					<Button.Content>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Image Source="{Binding PngResourcePath}"
								   MinWidth="20"
								   MinHeight="20"
								   Margin="0,0,8,0"
								   Grid.Column="0"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Left" />
							<TextBlock Text="{Binding Name}"
									   VerticalAlignment="Center"
									   Grid.Column="1" />
						</Grid>
					</Button.Content>
					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border x:Name="border"
												Background="{TemplateBinding Background}"
												BorderBrush="{TemplateBinding BorderBrush}"
												BorderThickness="{TemplateBinding BorderThickness}"
												CornerRadius="4">
											<ContentPresenter HorizontalAlignment="Center"
															  VerticalAlignment="Center"
															  Margin="{TemplateBinding Padding}" />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver"
													 Value="True">
												<Setter TargetName="border"
														Property="Background"
														Value="DarkGray" />
											</Trigger>
											<Trigger Property="IsPressed"
													 Value="True">
												<Setter TargetName="border"
														Property="Background"
														Value="#A0A0A0" />
											</Trigger>
											<Trigger Property="IsEnabled"
													 Value="False">
												<Setter TargetName="border"
														Property="Opacity"
														Value="0.5" />
												<Setter Property="Foreground"
														Value="#A0A0A0" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Setter Property="Background"
									Value="#F0F0F0" />
							<Setter Property="Foreground"
									Value="Black" />
							<Setter Property="BorderBrush"
									Value="#D0D0D0" />
							<Setter Property="BorderThickness"
									Value="1" />
							<Setter Property="Padding"
									Value="10,5" />
						</Style>
					</Button.Style>
				</Button>
			</DataTemplate>
		</ListView.ItemTemplate>
		<ListView.ItemsPanel>
			<ItemsPanelTemplate>
				<StackPanel Orientation="Vertical" />
			</ItemsPanelTemplate>
		</ListView.ItemsPanel>
	</ListView>
</UserControl>
