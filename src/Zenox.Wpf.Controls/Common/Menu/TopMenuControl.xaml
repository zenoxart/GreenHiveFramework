<UserControl x:Class="Zenox.Wpf.Controls.Common.Menu.TopMenuControl"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
		xmlns:tutorial="clr-namespace:Zenox.NET.Core.Common.Tutorial;assembly=Zenox.Wpf.Advanced"
xmlns:local="clr-namespace:Zenox.Wpf.Controls.Common.Menu" 
		xmlns:command="clr-namespace:Zenox.NET.Core.Common.Command;assembly=Zenox.NET.Core"
mc:Ignorable="d"
d:DesignHeight="450"
d:DesignWidth="800">
	<UserControl.Resources>
		<HierarchicalDataTemplate DataType="{x:Type command:RelayObject}"
								  ItemsSource="{Binding Children}">
			<MenuItem Header="{Binding Name}"
					  Command="{Binding Command}"
					  tutorial:TutorialHelper.TutorialKey="{Binding Name, StringFormat='TopMenu_{0}'}" />
		</HierarchicalDataTemplate>


	</UserControl.Resources>
	<Menu ItemsSource="{Binding MyTopMenu, 
        RelativeSource={RelativeSource FindAncestor, 
        AncestorType={x:Type local:TopMenuControl}}}"
		  tutorial:TutorialHelper.TutorialKey="TopMenuItems">
		<Menu.ItemContainerStyle>
			<Style TargetType="MenuItem">
				<Setter Property="Header"
						Value="{Binding Name}">
				</Setter>
				<Setter Property="Command"
						Value="{Binding Command}" />
				<Setter Property="Padding"
						Value="8,4,8,4" />
				<Setter Property="Margin"
						Value="2,0,2,0" />
				<Setter Property="FontFamily"
						Value="Segoe UI" />
				<Setter Property="FontSize"
						Value="14" />
				<Setter Property="Foreground"
						Value="White" />
				<Setter Property="Background"
						Value="Transparent" />
				<Setter Property="tutorial:TutorialHelper.TutorialKey"
						Value="{Binding Name, StringFormat='TopMenu_{0}'}" />
				<Style.Triggers>
					<Trigger Property="IsHighlighted"
							 Value="True">
						<Setter Property="Background"
								Value="{DynamicResource FluentAccentBrush}" />
						<Setter Property="Foreground"
								Value="{DynamicResource FluentSelectedTextBrush}" />
					</Trigger>
					<Trigger Property="IsEnabled"
							 Value="False">
						<Setter Property="Foreground"
								Value="{DynamicResource FluentDisabledTextBrush}" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</Menu.ItemContainerStyle>

	</Menu>
</UserControl>
