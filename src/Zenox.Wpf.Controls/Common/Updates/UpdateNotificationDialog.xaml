<Window x:Class="Zenox.Wpf.Controls.Common.Updates.UpdateNotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update verfuegbar"
        Width="550" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#1E1E1E" 
            BorderBrush="#404040" 
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="48" Height="48" 
                            Background="MediumPurple" 
                            CornerRadius="24"
                            Margin="0,0,12,0">
                        <TextBlock Text="&#x2B07;" 
                                  FontSize="28" 
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Neues Update verfuegbar!" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="CurrentVersionText"
                                      Text="Aktuelle Version: 1.0.0" 
                                      FontSize="12" 
                                      Foreground="#808080"/>
                            <TextBlock Text=" -&gt; " 
                                      FontSize="12" 
                                      Foreground="#808080"
                                      Margin="8,0"/>
                            <TextBlock x:Name="NewVersionText"
                                      Text="Neue Version: 1.1.0" 
                                      FontSize="12" 
                                      Foreground="MediumPurple"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Critical Badge -->
                <Border x:Name="CriticalBadge"
                       Background="#E81123"
                       CornerRadius="4"
                       Padding="8,4"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed">
                    <TextBlock Text="&#x26A0; Kritisches Update" 
                              FontSize="11" 
                              FontWeight="Bold"
                              Foreground="White"/>
                </Border>
            </StackPanel>

            <!-- Release Notes -->
            <Border Grid.Row="1" 
                    Background="#2D2D2D" 
                    BorderBrush="#404040" 
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Was ist neu:" 
                                  FontSize="13" 
                                  FontWeight="SemiBold"
                                  Foreground="White"
                                  Margin="0,0,0,12"/>
                        
                        <TextBlock x:Name="ReleaseNotesText"
                                  Text="Keine Informationen verfuegbar" 
                                  FontSize="12" 
                                  Foreground="#B0B0B0"
                                  TextWrapping="Wrap"
                                  LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Progress Bar -->
            <StackPanel Grid.Row="2" 
                       x:Name="ProgressPanel"
                       Visibility="Collapsed"
                       Margin="0,0,0,16">
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="ProgressText"
                              Text="Wird heruntergeladen..." 
                              FontSize="12" 
                              Foreground="#B0B0B0"
                              HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ProgressPercentText"
                              Text="0%" 
                              FontSize="12" 
                              Foreground="#B0B0B0"
                              HorizontalAlignment="Right"/>
                </Grid>
                
                <ProgressBar x:Name="DownloadProgressBar"
                            Height="8"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            Background="#2D2D2D"
                            Foreground="MediumPurple"
                            BorderThickness="0"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="3" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Right">
                <TextBlock x:Name="FileSizeText"
                          Text="Groesse: 50 MB"
                          FontSize="11"
                          Foreground="#808080"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>

                <Button x:Name="LaterButton"
                       Content="Spaeter" 
                       Width="100" 
                       Height="36"
                       Margin="0,0,12,0"
                       Click="LaterButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#404040"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#404040"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button x:Name="UpdateButton"
                       Content="Jetzt aktualisieren" 
                       Width="160" 
                       Height="36"
                       Click="UpdateButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="MediumPurple"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7B5DAA"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#404040"/>
                                    <Setter Property="Foreground" Value="#808080"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
