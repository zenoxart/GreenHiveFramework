<Window x:Class="Zenox.Wpf.Controls.Common.Snapshots.SnapshotManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zenox.Wpf.Controls.Common.Snapshots"
        mc:Ignorable="d"
        Title="Snapshot-Verwaltung"
        Height="600" Width="800"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BytesToKbConverter x:Key="BytesToKbConverter"/>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="MediumPurple"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Snapshot-Verwaltung" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#FFFFFF" 
                   Margin="0,0,0,10"/>

        <!-- Stats -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Gesamt: " Foreground="#8A8A8A" FontSize="14"/>
            <TextBlock x:Name="TotalCountText" Text="0" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="5,0"/>
            <TextBlock Text=" | Groesse: " Foreground="#8A8A8A" FontSize="14" Margin="10,0,0,0"/>
            <TextBlock x:Name="TotalSizeText" Text="0 MB" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="5,0"/>
        </StackPanel>

        <!-- Snapshot List -->
        <ListBox x:Name="SnapshotList" 
                 Grid.Row="2" 
                 Background="Transparent" 
                 BorderThickness="0"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#FFFFFF"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Type}" 
                                           FontSize="12" 
                                           Foreground="MediumPurple"
                                           Padding="5,2"
                                           Background="#2D2D2D"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" 
                                           FontSize="12" 
                                           Foreground="#8A8A8A"/>
                                <TextBlock Text=" | " Foreground="#8A8A8A" Margin="5,0"/>
                                <TextBlock FontSize="12" Foreground="#8A8A8A"
                                           Text="{Binding SizeBytes, Converter={StaticResource BytesToKbConverter}, StringFormat='{}{0:F2} KB'}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="Wiederherstellen" 
                                Margin="10,0,0,0"
                                Click="RestoreButton_Click"
                                Tag="{Binding}"/>
                        <Button Grid.Column="2" 
                                Content="🗑️" 
                                Width="35"
                                Margin="5,0,0,0"
                                Background="#E81123"
                                Click="DeleteButton_Click"
                                Tag="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Neuer Snapshot" Click="CreateSnapshot_Click"/>
            <Button Content="Alle loeschen" Click="ClearAll_Click" Background="#E81123"/>
            <Button Content="Schliessen" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
