<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF client of the Reporting module: loaded at run time into its own AssemblyLoadContext (code-only views, hot-swappable). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GreenHive.NET.Modules.Reporting.Client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="..\..\ModuleClient.targets" />

</Project>
