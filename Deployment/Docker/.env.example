# Green Hive - Docker Compose settings. Copy to ".env" and change the secrets for anything beyond a local demo.
# .env is ignored by git.

POSTGRES_PASSWORD=greenhive
# At least 32 characters; every service validates the JWTs with this key.
GREENHIVE_JWT_KEY=change-me-greenhive-demo-signing-key-0123456789
# Key for service-to-service calls of /internal endpoints (never routed by the gateway).
GREENHIVE_INTERNAL_KEY=change-me-greenhive-internal-key
# Port of the API gateway on the host.
GREENHIVE_PORT=8080
# true = error responses contain exception details (development only).
GREENHIVE_SHOW_ERROR_DETAILS=false

# AI agent: "rules" (offline, deterministic) or "openai" (any OpenAI-compatible endpoint).
GREENHIVE_AI_PROVIDER=rules
GREENHIVE_AI_ENDPOINT=https://api.openai.com/v1
GREENHIVE_AI_API_KEY=
GREENHIVE_AI_MODEL=gpt-4o-mini
# Rules agent: invoices above this amount are handed to a person.
GREENHIVE_AI_REVIEW_ABOVE=20000

# Optional Windows push (WNS) for users without a live connection.
GREENHIVE_WNS_CLIENT_ID=
GREENHIVE_WNS_CLIENT_SECRET=
